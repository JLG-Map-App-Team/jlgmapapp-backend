# Copy to .env and adjust if you change docker-compose.yml credentials/ports.
DATABASE_URL=postgres://jlgmapapp:jlgmapapp_dev@localhost:5432/jlgmapapp?sslmode=disable

# Cloudflare R2 — used by scripts/tiles/run.mjs (D3) to upload the Detroit
# PMTiles basemap extract via wrangler. Not required for --dry-run. Create
# the API token at dashboard > My Profile > API Tokens, permission
# "Workers R2 Storage: Edit". Account ID is on the R2 overview page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
