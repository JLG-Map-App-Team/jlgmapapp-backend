{
  "name": "jlgmapapp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend services and ETL tooling for the Joe Louis Greenway map application.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint:api": "redocly lint",
    "lint": "npm run lint:api",
    "gen:api": "openapi-typescript",
    "seed:build": "node scripts/seed/build-segments-seed.mjs",
    "gen:api:check": "node scripts/check-api-types-fresh.mjs",
    "typecheck": "tsc --noEmit",
  "seed": "node scripts/seed.mjs",
  "test": "node --test scripts/seed-contract.test.mjs scripts/seed.test.mjs",
  "test:a11y": "node --test scripts/accessibility.test.mjs",
  "build": "tsc",
  "db:migrate": "node scripts/apply-migrations.mjs",
  "topology:spike": "node scripts/topology-spike.mjs",
  "verify:migrations": "node scripts/verify-migrations.mjs",
  "verify": "npm run lint:api && npm run gen:api:check && npm run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "dbmate --migrations-dir ./src/database/migrations --migrations-table public.schema_migrations up",
    "migrate:rollback": "dbmate --migrations-dir ./src/database/migrations --migrations-table public.schema_migrations rollback",
    "migrate:status": "dbmate --migrations-dir ./src/database/migrations --migrations-table public.schema_migrations status",
    "migrate:new": "dbmate --migrations-dir ./src/database/migrations new"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.2",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
