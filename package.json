{
  "name": "jlgmapapp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend services and ETL tooling for the Joe Louis Greenway map application.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint:api": "redocly lint",
    "gen:api": "openapi-typescript",
    "fixture:build": "node scripts/seed/build-segments-fixture.mjs",
    "contract:demo": "node --env-file-if-exists=.env scripts/contract/demo-response-validation.mjs",
    "gen:api:check": "node scripts/check-api-types-fresh.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint:api && npm run gen:api:check && npm run typecheck",
    "build": "tsc",
    "test:contract": "node --test scripts/seedcontract.test.mjs",
    "test:load": "npm run build && node --env-file-if-exists=.env --test scripts/segmentsload.test.mjs",
    "test:integration": "npm run build && node --env-file-if-exists=.env --test scripts/segments.integration.test.mjs",
    "test:routing-gate": "node --env-file-if-exists=.env --test scripts/routing-gate.test.mjs",
    "topology:spike": "node scripts/topology-spike.mjs",
    "buffer:spike": "node --env-file-if-exists=.env scripts/buffer-spike.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "bootstrap": "npm run db:up && npm run migrate && npm run etl:segments",
    "migrate": "dbmate --migrations-dir ./src/database/migrations --migrations-table public.schema_migrations up",
    "migrate:rollback": "dbmate --migrations-dir ./src/database/migrations --migrations-table public.schema_migrations rollback",
    "migrate:status": "dbmate --migrations-dir ./src/database/migrations --migrations-table public.schema_migrations status",
    "migrate:new": "dbmate --migrations-dir ./src/database/migrations new",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "db:reset": "dbmate --migrations-dir ./src/database/migrations --migrations-table public.schema_migrations drop && dbmate --migrations-dir ./src/database/migrations --migrations-table public.schema_migrations up",
    "etl:segments": "npm run build && node --env-file-if-exists=.env scripts/etl/run.mjs city_route_segments",
    "etl:segments:dry": "npm run build && node --env-file-if-exists=.env scripts/etl/run.mjs city_route_segments --dry-run",
    "test:segments": "npm run build && node --test scripts/segments.integration.test.mjs",
    "lint": "npm run lint:api",
    "seed": "node scripts/seed.mjs",
    "test": "npm run build && node --test scripts/seedcontract.test.mjs scripts/segmentsload.test.mjs scripts/segments.integration.test.mjs scripts/segments.contract.test.mjs scripts/tiles.contract.test.mjs",
    "tiles:detroit": "node --env-file-if-exists=.env scripts/tiles/run.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "test:a11y": "node --test scripts/accessibility.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "4.13.0",
    "dbmate": "2.35.0",
    "js-yaml": "^4.1.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
